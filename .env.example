# ============================================================
# .env.example — travelfrontend environment template
# ============================================================
# Copy to .env.local for development. Docker builds take them as build
# args (see docker-compose.yml): they are baked in at build time. Only NEXT_PUBLIC_* vars exist —
# no secrets ever live in the frontend.
# ============================================================

# Backend API base URL (trailing slash required)
#   local dev:   http://127.0.0.1:8000/api/
#   staging:     https://staging.azuratravelsbackend.cc/api/
#   production:  https://azuratravelsbackend.cc/api/
NEXT_PUBLIC_API_URL=https://azuratravelsbackend.cc/api/

# Public site address (sitemap, robots). Anything but the live address
# tells search engines to stay away (staging, previews).
#   staging:     https://staging.azuratravels.live
NEXT_PUBLIC_SITE_URL=https://azuratravels.live

# Paystack Inline popup for card payments (default "true").
# "false" forces the hosted redirect page — no other change needed.
NEXT_PUBLIC_PAYSTACK_USE_POPUP=true
